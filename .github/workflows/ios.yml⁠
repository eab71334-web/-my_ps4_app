name: Build iOS Project

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build-ios:
    runs-on: macos-14

    steps:
    - name: Checkout Code
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: Install System Dependencies
      run: |
        brew install autoconf automake libtool pkg-config sqlite3 cmake

    - name: Install Kivy iOS Toolchain
      run: |
        python -m pip install --upgrade pip
        pip install kivy-ios

    - name: Build Python3 and Kivy Recipe
      run: |
        toolchain build python3 kivy

    - name: Create Xcode Project
      run: |
        toolchain create PS4App .

    - name: Compress Xcode Project
      run: |
        zip -r PS4App-iOS-Xcode.zip PS4App-ios

    - name: Upload Xcode Artifact
      uses: actions/upload-artifact@v4
      with:
        name: PS4App-iOS-Xcode
        path: PS4App-iOS-Xcode.zip
